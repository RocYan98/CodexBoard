{
  "name": "@codexboard/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#private-file-permissions": "./scripts/private-file-permissions.mjs",
    "#codex-windows-app": "./scripts/codex-windows-app.mjs",
    "#node-script-arguments": "./scripts/node-script-arguments.mjs",
    "#windows-system-environment": "./scripts/windows-system-environment.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "packages/taskctl",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "db:migrate": "npm run db:migrate -w @codexboard/server",
    "ops:backup": "npm run ops -w @codexboard/server -- backup",
    "ops:verify": "npm run ops -w @codexboard/server -- verify",
    "ops:restore": "npm run ops -w @codexboard/server -- restore",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:desktop": "node apps/desktop/scripts/build-macos.mjs",
    "release:desktop": "node apps/desktop/scripts/release-macos.mjs",
    "build:desktop:windows": "node apps/desktop/scripts/build-windows.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "smol-toml": "1.8.0"
  }
}
